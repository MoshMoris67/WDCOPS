// WellcashOps data model — mirrors §6 of the Wellcash Uganda requirements doc.
// Self-hosted Postgres in both dev (docker-compose.yml) and production — no
// third-party service may hold client data, so DATABASE_URL always points at
// a Postgres instance you run yourself, never a managed DB-as-a-service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  reconciliationType String // "full" | "partial"
  reportingFrequency String // "daily" | "weekly" | "monthly"
  branch             String   @default("uganda")
  createdAt          DateTime @default(now())

  // Only set for a client whose reconciliation files carry commission-relevant aging
  // buckets (currently just KCB Mopesa, where each sheet in the file IS a bucket — see
  // lib/commission.ts). A client with no CommissionRate rows behaves exactly as before;
  // this is opt-in per client, never a default. agentCommissionShare is per-client since
  // a future client's split could differ from KCB Mopesa's 20%.
  commissionRates      CommissionRate[]
  agentCommissionShare Float            @default(0.20)

  files           File[]
  reconciliations Reconciliation[]
}

// Bucket → commission rate for one client. Admin-managed (see api/commission-rates),
// same simple pattern as DispositionCode. "bucket" is a canonical key (B30/B60/B90/B120/WO
// — see lib/commission.ts's canonicalizeBucket), not a raw sheet/column label, so the rate
// table stays stable even though a client's raw sheet names vary ("90-120" vs "Before 120"
// both canonicalize to buckets that already have a configured rate here).
model CommissionRate {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
  bucket   String // B30 | B60 | B90 | B120 | WO
  rate     Float  // e.g. 0.04 for 4%

  @@unique([clientId, bucket])
  @@index([clientId])
}

model File {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  batchLabel      String
  receivedDate    DateTime
  isMidMonthTopup Boolean  @default(false)
  isRecalled      Boolean  @default(false)
  branch          String   @default("uganda")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Large imports are parsed AND inserted a chunk at a time by POST /api/worker/tick,
  // called on a schedule by an external cron (see .github/workflows/worker-tick.yml)
  // rather than during the upload request — so a slow host never times out the request,
  // and no single tick has to finish 77,000 rows before its own request is allowed to.
  // "complete" is the default so every pre-existing row (imported the old, synchronous
  // way) reads as already-done without a backfill. "queued" means no tick has picked it
  // up yet. Two-stage, since parsing a large file turned out to be slow enough on its own
  // to cause the same hang inserting used to: rawFile/rawFileName hold the raw upload
  // (base64) + confirmed column mapping (importMapping) until the first tick parses it
  // into rawRows (JSON, same as Reconciliation.rawRows below) — rawFile is cleared once
  // parsed. Every tick after that inserts the next chunk from rowsProcessed, same as
  // before. importWarnings holds any skipped-row messages from parsing (JSON string[]),
  // kept since the admin can no longer see them at submit time now that parsing has moved
  // off that request.
  importStatus   String  @default("complete") // queued | processing | complete | failed
  importError    String?
  importWarnings String?
  rawFile        String?
  rawFileName    String?
  importMapping  String?
  rawRows        String?
  rowsProcessed  Int     @default(0)
  // Set the moment a tick claims this file's parse step, cleared the moment parsing
  // finishes (success or failure) — a second tick firing while parsing is still running
  // (parsing is fire-and-forget, not awaited by the tick's own response; see
  // api/worker/tick/route.ts) checks this before claiming so it doesn't launch a
  // duplicate parse of the same file. Stale (older than a few minutes, meaning the
  // process likely restarted mid-parse) is treated as abandoned and reclaimable.
  parsingStartedAt DateTime?
  // Counts each claim attempt (not each tick — only when a tick actually starts running
  // this file). A file too large for available memory crashes the exact same way every
  // time it's retried, so past a small limit the tick gives up and marks it 'failed'
  // instead of quietly re-crashing the instance on a fixed retry cadence forever.
  importAttempts   Int     @default(0)

  // "Already distributed outside the app" import: the uploaded workbook has one sheet per
  // agent (plus, typically, a combined reference sheet) instead of one flat roster —
  // runFileImport assigns each row straight to its sheet's resolved agent instead of
  // leaving everything unassigned for the usual Run Auto-Distribution step. sheetPlan is
  // the admin's confirmed per-sheet choice from the import preview (JSON: sheet name ->
  // { action: "assign", agentId } | { action: "unassigned" } | { action: "skip" } — "skip"
  // is how a combined/reference sheet is excluded so its rows aren't double-imported).
  // Both fields are write-once at POST /api/files time and read once by runFileImport.
  isDistributedImport Boolean @default(false)
  sheetPlan           String?

  debtors         Debtor[]
  reconciliations Reconciliation[]
  fileSyncs       FileSync[]

  @@index([clientId])
}

model Debtor {
  id              String    @id @default(cuid())
  fileId          String
  file            File      @relation(fields: [fileId], references: [id])
  name            String
  phone1          String
  phone2          String?
  loanRef         String
  amountOwed      Float
  cumulativePaid  Float     @default(0)
  balance         Float
  assignedAgentId String?
  assignedAgent   User?     @relation("AgentDebtors", fields: [assignedAgentId], references: [id])
  branch          String    @default("uganda")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  callLogs             CallLog[]
  assignments          Assignment[]
  reconciliationEntries ReconciliationEntry[]

  @@index([fileId])
  @@index([assignedAgentId])
  @@index([loanRef])
  @@index([phone1])
  @@index([fileId, assignedAgentId])
}

model CallLog {
  id              String    @id @default(cuid())
  debtorId        String
  debtor          Debtor    @relation(fields: [debtorId], references: [id])
  agentId         String
  agent           User      @relation("AgentCallLogs", fields: [agentId], references: [id])
  dispositionCode String
  note            String?
  promisedAmount  Float?
  promisedDate    DateTime?
  createdAt       DateTime  @default(now())
  syncedAt        DateTime?

  @@index([debtorId])
  @@index([agentId])
  @@index([debtorId, createdAt])
  @@index([createdAt])
}

model Reconciliation {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  fileId       String?
  file         File?     @relation(fields: [fileId], references: [id])
  type         String // "full" | "partial"
  receivedAt   DateTime
  processedAt  DateTime?
  recordCount      Int
  updatedCount     Int       @default(0)
  newAccountsCount Int       @default(0)
  unmatchedCount   Int       @default(0)
  totalUpdated     Float     @default(0)
  notes        String?
  errorSummary String?
  // Same two-stage design as File above: uploading only base64-stores the raw file +
  // confirmed mapping (rawFile/rawFileName/mapping) and returns immediately — parsing a
  // large file synchronously in the request is what caused the exact same "Could not
  // reach the server" hang file imports had. The worker tick parses it into rawRows
  // (JSON-encoded parsed rows) as its own step, clearing rawFile once done; rawRows is
  // also what "process now" and the tick's processing step read from, kept so either can
  // retry without a re-upload.
  rawFile      String?
  rawFileName  String?
  mapping      String?
  rawRows      String?
  // Same claim/stale-recovery mechanism as File.parsingStartedAt — see that comment.
  parsingStartedAt DateTime?
  // Processing (matching rawRows against debtors) is chunked and resumable across ticks,
  // same idea as File.rowsProcessed — rowsProcessed is the cursor into rawRows,
  // updatedCount/newAccountsCount/unmatchedCount/totalUpdated accumulate across chunks.
  // A row that doesn't match an existing debtor but carries enough info to become a new
  // account is held in pendingNewAccountRows (JSON) until the last chunk, rather than
  // creating its own "new accounts" File once per chunk.
  rowsProcessed         Int     @default(0)
  pendingNewAccountRows String?
  status       String    @default("pending") // pending | processed | failed
  branch       String    @default("uganda")
  createdAt    DateTime  @default(now())

  entries ReconciliationEntry[]

  @@index([clientId])
}

// One row per debtor actually touched by a reconciliation — the audit trail for
// §7's "team leaders see a running log ... nothing silently lost" and the source
// of a debtor's "recently paid" flag.
model ReconciliationEntry {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id])
  debtorId         String
  debtor           Debtor         @relation(fields: [debtorId], references: [id])
  oldBalance       Float
  newBalance       Float
  paidAmount       Float
  createdAt        DateTime       @default(now())

  // Set only when this row's client has commission rates configured (see Client.commissionRates)
  // — null for every other client's entries, unchanged from before this feature existed.
  // bucket is the canonical key (see lib/commission.ts) this row's amount was priced at.
  bucket            String?
  companyCommission Float?
  agentCommission   Float?

  // The real-world payment date from the source file (see lib/daily-sync.ts) — distinct
  // from createdAt, which is when wellcashops recorded the entry. Null for every
  // reconciliation entry created before this feature (a normal upload has no concept of a
  // payment date separate from processing time). Only a daily-sync run sets this, and only
  // a daily-sync run reads it back: a client like Zenka re-sends its full payment history
  // in every file, so "has an entry for this exact debtor/date/amount already been
  // recorded" (via paidDate + paidAmount) is what stops the same payment from being
  // re-applied and double-counting recoveries on every re-upload.
  paidDate DateTime?

  @@index([reconciliationId])
  @@index([debtorId])
  @@index([debtorId, paidDate])
}

// One upload of a client's full daily export (a calling-list sheet + a payments sheet, see
// lib/daily-sync.ts) against a File that already exists — for a client like Zenka whose
// daily file is a full accumulating snapshot of their whole book, not a discrete new batch.
// Two things happen per run, both reusing existing machinery rather than new logic:
// (1) any loanRef on the calling-list sheet not already a Debtor on this File is created
// and auto-distributed the same coverage-weighted way reconciliation.ts's new-account path
// already does; (2) payment rows from the payments sheet, filtered to the current calendar
// month, become a real Reconciliation + ReconciliationEntry rows (deduplicated via
// ReconciliationEntry.paidDate) — so existing recovery reporting needs zero changes to
// pick these up. Same two-stage raw-upload-then-tick-parses pattern as File/Reconciliation
// above, for the same reason (a large file synchronously parsed in the request times out).
model FileSync {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id])

  status String  @default("queued") // queued | processing | complete | failed
  error  String?

  rawFile            String?
  rawFileName        String?
  callingListMapping String? // JSON ImportMapping, confirmed at upload time
  paymentMapping     String? // JSON SyncPaymentMapping, confirmed at upload time

  newDebtorsCount       Int @default(0)
  paymentsAppliedCount  Int @default(0)
  paymentsSkippedCount  Int @default(0) // already recorded from an earlier sync — not an error

  // Same claim/stale-recovery mechanism as File.parsingStartedAt — see that comment.
  parsingStartedAt DateTime?
  // Same give-up-after-N-crashes mechanism as File.importAttempts — see that comment.
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  completedAt DateTime?

  @@index([fileId])
  @@index([status])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String // admin | agent
  status         String   @default("active")
  branch         String   @default("uganda")
  createdAt      DateTime @default(now())

  assignedDebtors Debtor[]     @relation("AgentDebtors")
  callLogs        CallLog[]    @relation("AgentCallLogs")
  assignmentsTo   Assignment[] @relation("AssignedTo")
}

model Assignment {
  id               String   @id @default(cuid())
  debtorId         String
  debtor           Debtor   @relation(fields: [debtorId], references: [id])
  agentId          String
  agent            User     @relation("AssignedTo", fields: [agentId], references: [id])
  assignedAt       DateTime @default(now())
  reassignedFromId String?

  @@index([debtorId])
}

// Admin-managed — the whole point is that new codes an admin adds show up
// everywhere (call-logging form, badges, charts) without a code change.
model DispositionCode {
  code             String  @id
  label            String
  description      String?
  color            String  @default("#64748B") // hex, drives badge + chart colors
  requiresCallback Boolean @default(false)
  requiresPtp      Boolean @default(false)
}
