// WellcashOps data model — mirrors §6 of the Wellcash Uganda requirements doc.
// Self-hosted Postgres in both dev (docker-compose.yml) and production — no
// third-party service may hold client data, so DATABASE_URL always points at
// a Postgres instance you run yourself, never a managed DB-as-a-service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  reconciliationType String // "full" | "partial"
  reportingFrequency String // "daily" | "weekly" | "monthly"
  branch             String   @default("uganda")
  createdAt          DateTime @default(now())

  files           File[]
  reconciliations Reconciliation[]
}

model File {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  batchLabel      String
  receivedDate    DateTime
  isMidMonthTopup Boolean  @default(false)
  isRecalled      Boolean  @default(false)
  branch          String   @default("uganda")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Large imports are parsed AND inserted a chunk at a time by POST /api/worker/tick,
  // called on a schedule by an external cron (see .github/workflows/worker-tick.yml)
  // rather than during the upload request — so a slow host never times out the request,
  // and no single tick has to finish 77,000 rows before its own request is allowed to.
  // "complete" is the default so every pre-existing row (imported the old, synchronous
  // way) reads as already-done without a backfill. "queued" means no tick has picked it
  // up yet. Two-stage, since parsing a large file turned out to be slow enough on its own
  // to cause the same hang inserting used to: rawFile/rawFileName hold the raw upload
  // (base64) + confirmed column mapping (importMapping) until the first tick parses it
  // into rawRows (JSON, same as Reconciliation.rawRows below) — rawFile is cleared once
  // parsed. Every tick after that inserts the next chunk from rowsProcessed, same as
  // before. importWarnings holds any skipped-row messages from parsing (JSON string[]),
  // kept since the admin can no longer see them at submit time now that parsing has moved
  // off that request.
  importStatus   String  @default("complete") // queued | processing | complete | failed
  importError    String?
  importWarnings String?
  rawFile        String?
  rawFileName    String?
  importMapping  String?
  rawRows        String?
  rowsProcessed  Int     @default(0)

  debtors         Debtor[]
  reconciliations Reconciliation[]

  @@index([clientId])
}

model Debtor {
  id              String    @id @default(cuid())
  fileId          String
  file            File      @relation(fields: [fileId], references: [id])
  name            String
  phone1          String
  phone2          String?
  loanRef         String
  amountOwed      Float
  cumulativePaid  Float     @default(0)
  balance         Float
  assignedAgentId String?
  assignedAgent   User?     @relation("AgentDebtors", fields: [assignedAgentId], references: [id])
  branch          String    @default("uganda")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  callLogs             CallLog[]
  assignments          Assignment[]
  reconciliationEntries ReconciliationEntry[]

  @@index([fileId])
  @@index([assignedAgentId])
  @@index([loanRef])
  @@index([phone1])
  @@index([fileId, assignedAgentId])
}

model CallLog {
  id              String    @id @default(cuid())
  debtorId        String
  debtor          Debtor    @relation(fields: [debtorId], references: [id])
  agentId         String
  agent           User      @relation("AgentCallLogs", fields: [agentId], references: [id])
  dispositionCode String
  note            String?
  promisedAmount  Float?
  promisedDate    DateTime?
  createdAt       DateTime  @default(now())
  syncedAt        DateTime?

  @@index([debtorId])
  @@index([agentId])
  @@index([debtorId, createdAt])
  @@index([createdAt])
}

model Reconciliation {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  fileId       String?
  file         File?     @relation(fields: [fileId], references: [id])
  type         String // "full" | "partial"
  receivedAt   DateTime
  processedAt  DateTime?
  recordCount      Int
  updatedCount     Int       @default(0)
  newAccountsCount Int       @default(0)
  unmatchedCount   Int       @default(0)
  totalUpdated     Float     @default(0)
  notes        String?
  errorSummary String?
  // Same two-stage design as File above: uploading only base64-stores the raw file +
  // confirmed mapping (rawFile/rawFileName/mapping) and returns immediately — parsing a
  // large file synchronously in the request is what caused the exact same "Could not
  // reach the server" hang file imports had. The worker tick parses it into rawRows
  // (JSON-encoded parsed rows) as its own step, clearing rawFile once done; rawRows is
  // also what "process now" and the tick's processing step read from, kept so either can
  // retry without a re-upload.
  rawFile      String?
  rawFileName  String?
  mapping      String?
  rawRows      String?
  // Processing (matching rawRows against debtors) is chunked and resumable across ticks,
  // same idea as File.rowsProcessed — rowsProcessed is the cursor into rawRows,
  // updatedCount/newAccountsCount/unmatchedCount/totalUpdated accumulate across chunks.
  // A row that doesn't match an existing debtor but carries enough info to become a new
  // account is held in pendingNewAccountRows (JSON) until the last chunk, rather than
  // creating its own "new accounts" File once per chunk.
  rowsProcessed         Int     @default(0)
  pendingNewAccountRows String?
  status       String    @default("pending") // pending | processed | failed
  branch       String    @default("uganda")
  createdAt    DateTime  @default(now())

  entries ReconciliationEntry[]

  @@index([clientId])
}

// One row per debtor actually touched by a reconciliation — the audit trail for
// §7's "team leaders see a running log ... nothing silently lost" and the source
// of a debtor's "recently paid" flag.
model ReconciliationEntry {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id])
  debtorId         String
  debtor           Debtor         @relation(fields: [debtorId], references: [id])
  oldBalance       Float
  newBalance       Float
  paidAmount       Float
  createdAt        DateTime       @default(now())

  @@index([reconciliationId])
  @@index([debtorId])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String // admin | agent
  status         String   @default("active")
  branch         String   @default("uganda")
  createdAt      DateTime @default(now())

  assignedDebtors Debtor[]     @relation("AgentDebtors")
  callLogs        CallLog[]    @relation("AgentCallLogs")
  assignmentsTo   Assignment[] @relation("AssignedTo")
}

model Assignment {
  id               String   @id @default(cuid())
  debtorId         String
  debtor           Debtor   @relation(fields: [debtorId], references: [id])
  agentId          String
  agent            User     @relation("AssignedTo", fields: [agentId], references: [id])
  assignedAt       DateTime @default(now())
  reassignedFromId String?

  @@index([debtorId])
}

// Admin-managed — the whole point is that new codes an admin adds show up
// everywhere (call-logging form, badges, charts) without a code change.
model DispositionCode {
  code             String  @id
  label            String
  description      String?
  color            String  @default("#64748B") // hex, drives badge + chart colors
  requiresCallback Boolean @default(false)
  requiresPtp      Boolean @default(false)
}
